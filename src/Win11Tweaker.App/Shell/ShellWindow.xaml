<Window x:Class="Win11Tweaker.App.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Win11Tweaker.App.Shell"
        Title="Win11 Tweaker"
        Icon="/Assets/win11tweaker.ico"
        Width="1120" Height="700"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Base}"
        FontFamily="{StaticResource UiFont}"
        FontSize="16"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <shell:ShellViewModel />
    </Window.DataContext>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Background="{StaticResource Base}">

            <Rectangle VerticalAlignment="Bottom" Height="1" Fill="{StaticResource Line}" />

            <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">

                <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="0"  Canvas.Top="0"  Width="11" Height="11"
                                   RadiusX="2.6" RadiusY="2.6" Fill="{StaticResource Ink}" />
                        <Rectangle Canvas.Left="13" Canvas.Top="0"  Width="11" Height="11"
                                   RadiusX="2.6" RadiusY="2.6" Fill="{StaticResource Ink}" />
                        <Rectangle Canvas.Left="0"  Canvas.Top="13" Width="11" Height="11"
                                   RadiusX="2.6" RadiusY="2.6" Fill="{StaticResource Ink}" />
                        <Rectangle Canvas.Left="13" Canvas.Top="13" Width="11" Height="11"
                                   RadiusX="2.6" RadiusY="2.6">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF8B96F6" Offset="0" />
                                    <GradientStop Color="#FF5562D6" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="WIN11 TWEAKER"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" />
                <TextBlock Text="{x:Static shell:AppInfo.Version}"
                           Margin="12,1,0,0"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkFaint}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" Click="OpenSettings" ToolTip="Настройки" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Collapse" ToolTip="Свернуть" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Dismiss" ToolTip="Закрыть" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource Base}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,6,16,14" Height="38">
                    <TextBox x:Name="SearchInput"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock IsHitTestVisible="False"
                               Margin="13,0,0,0"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkFaint}"
                               Text="Поиск по всем разделам">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavView}"
                         SelectedItem="{Binding Selected}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,0,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource GroupLabel}"
                                               Margin="21,16,0,7" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="20,0,20,16">
                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,12" />
                    <TextBlock Text="{x:Static shell:AppInfo.Full}" FontSize="12"
                               Foreground="{StaticResource InkFaint}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="10,0,0,0">

                <ContentControl Content="{Binding Current}"
                                HorizontalAlignment="Stretch" />
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
              Background="#E60B0C0E"
              Visibility="{Binding Busy.Active, Converter={StaticResource Bool2Vis}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                    <Ellipse Width="44" Height="44" Stroke="{StaticResource LineStrong}" StrokeThickness="3" />
                    <Ellipse Width="44" Height="44" Stroke="{StaticResource Accent}" StrokeThickness="3"
                             StrokeDashArray="9 40" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="{Binding Busy.Title}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,22,0,0" Foreground="{StaticResource Ink}" />
                <TextBlock Text="{Binding Busy.Detail}" FontSize="14" TextWrapping="Wrap"
                           TextAlignment="Center" LineHeight="21" Margin="0,10,0,0"
                           Foreground="{StaticResource InkDim}" />
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,28,26"
                      IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border CornerRadius="10" Padding="18,14,12,14" Margin="0,10,0,0"
                            MinWidth="340" MaxWidth="520"
                            Background="{StaticResource Floating}"
                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                            Effect="{StaticResource Lift}" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform Y="14" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Text}" FontSize="14"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,1,14,0" Foreground="{StaticResource Ink}" />

                            <Button Grid.Column="1" Style="{StaticResource Primary}"
                                    Content="{Binding ActionLabel}"
                                    FontSize="12.5" Padding="16,8" Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding Run}"
                                    Visibility="{Binding HasAction, Converter={StaticResource Bool2Vis}}" />

                            <Button Grid.Column="2" Style="{StaticResource CaptionButton}"
                                    Width="26" Height="24" VerticalAlignment="Top"
                                    Content="&#xE8BB;" Command="{Binding Dismiss}"
                                    ToolTip="Скрыть" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
