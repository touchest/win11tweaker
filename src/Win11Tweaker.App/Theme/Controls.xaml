<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="Bool2Vis" />

  <DropShadowEffect x:Key="Lift" Color="#FF000000" BlurRadius="24" ShadowDepth="6"
                    Direction="270" Opacity="0.28" RenderingBias="Performance" />

  <SolidColorBrush x:Key="CardFace" Color="#FF17181D" />

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Background" Value="{StaticResource CardFace}" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="GroupLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
  </Style>

  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="42" Height="24" Background="Transparent">
            <Border x:Name="Track"
                    CornerRadius="12"
                    Background="{StaticResource TrackOff}"
                    BorderThickness="1"
                    BorderBrush="Transparent" />
            <Ellipse x:Name="Knob"
                     Width="18" Height="18"
                     HorizontalAlignment="Left"
                     Margin="3,0,0,0"
                     Fill="#FF8A8C97">
              <Ellipse.RenderTransform>
                <TranslateTransform x:Name="KnobShift" X="0" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource LineStrong}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobShift"
                                     Storyboard.TargetProperty="X"
                                     To="18" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobShift"
                                     Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentInk}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                  Margin="8,1,8,1" Height="34">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="Bar" Grid.Column="0"
                         Width="2" Height="14"
                         HorizontalAlignment="Left"
                         Fill="{StaticResource Accent}"
                         RadiusX="1" RadiusY="1"
                         RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                  <ScaleTransform x:Name="BarScale" ScaleY="0" />
                </Rectangle.RenderTransform>
              </Rectangle>
              <TextBlock x:Name="Label" Grid.Column="1"
                         Text="{Binding Title}"
                         Margin="6,0,0,0"
                         FontSize="14"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource InkDim}" />

              <Border x:Name="Pill" Grid.Column="2"
                      Margin="0,0,10,0"
                      CornerRadius="6"
                      Padding="7,2"
                      Background="{StaticResource Elevated}"
                      Visibility="Collapsed">
                <TextBlock Text="{Binding Badge}"
                           FontSize="12"
                           Foreground="{StaticResource InkFaint}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Badge}" Value="">
              <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
              <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BarScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.12">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BarScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="0" Duration="0:0:0.10" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
              <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink}" />
              <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SpectrumInk}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>

            <Border x:Name="Fill" CornerRadius="6">
              <Border.Background>
                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="170,44" SpreadMethod="Repeat">
                  <LinearGradientBrush.Transform>
                    <TranslateTransform X="0" />
                  </LinearGradientBrush.Transform>
                  <GradientStop Color="#FF5B67DC" Offset="0.00" />
                  <GradientStop Color="#FF6E7BE8" Offset="0.28" />
                  <GradientStop Color="#FF9AA2F6" Offset="0.50" />
                  <GradientStop Color="#FF6E7BE8" Offset="0.72" />
                  <GradientStop Color="#FF5B67DC" Offset="1.00" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <Border x:Name="Veil" CornerRadius="6" Background="Transparent" />
            <ContentPresenter x:Name="Text" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextBlock.TextAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                  <DoubleAnimation
                      Storyboard.TargetName="Fill"
                      Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.Transform).(TranslateTransform.X)"
                      From="0" To="170" Duration="0:0:3.6" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Veil" Property="Background" Value="#20FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Veil" Property="Background" Value="#26000000" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Veil" Property="Background" Value="{StaticResource Pressed}" />
              <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource InkFaint}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ghost" TargetType="Button">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">

          <Border x:Name="Fill" CornerRadius="6"
                  Background="{StaticResource Hover}"
                  BorderBrush="{StaticResource LineStrong}"
                  BorderThickness="1"
                  Padding="16,9">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{StaticResource Pressed}" />
              <Setter TargetName="Fill" Property="BorderBrush" Value="#FF3A3C46" />
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="#FF2C2E38" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
              <Setter TargetName="Fill" Property="Background" Value="{StaticResource Elevated}" />
              <Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource Line}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill" Background="Transparent">

            <TextBlock x:Name="Glyph"
                       Text="{TemplateBinding Content}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="11"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{StaticResource Hover}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill" Background="Transparent">
            <TextBlock x:Name="Glyph"
                       Text="{TemplateBinding Content}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="11"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="#FFC0342A" />
              <Setter TargetName="Glyph" Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="CaretBrush" Value="{StaticResource InkDim}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Fill" CornerRadius="6"
                    Background="{StaticResource Base}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    Padding="12,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                    Margin="6,0,6,0" CornerRadius="1"
                    Background="{StaticResource Accent}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="UnderlineScale" ScaleX="0" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource LineStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="UnderlineScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource Spectrum}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Meter" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{StaticResource TrackOff}" CornerRadius="2" />

            <Grid x:Name="PART_Track" />
            <Border x:Name="PART_Indicator"
                    HorizontalAlignment="Left"
                    CornerRadius="2"
                    Background="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" Background="#FF2E2F37" CornerRadius="3"
                              Width="6" HorizontalAlignment="Center" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="T" Property="Width" Value="8" />
                          <Setter TargetName="T" Property="Background" Value="#FF3A3B44" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
