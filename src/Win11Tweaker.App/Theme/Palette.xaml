<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Base"     Color="#FF0B0C0E" />
  <SolidColorBrush x:Key="Surface"  Color="#FF101114" />
  <SolidColorBrush x:Key="Elevated" Color="#FF17181D" />
  <SolidColorBrush x:Key="Hover"    Color="#FF1C1D22" />
  <SolidColorBrush x:Key="Pressed"  Color="#FF24252D" />

  <SolidColorBrush x:Key="Floating" Color="#FF23242C" />

  <SolidColorBrush x:Key="Line"       Color="#FF1E1F25" />
  <SolidColorBrush x:Key="LineStrong" Color="#FF2C2D34" />

  <SolidColorBrush x:Key="Ink"      Color="#FFECEDF1" />
  <SolidColorBrush x:Key="InkDim"   Color="#FF9A9CA7" />
  <SolidColorBrush x:Key="InkFaint" Color="#FF74767F" />

  <SolidColorBrush x:Key="Accent"        Color="#FF6E7BE8" />
  <SolidColorBrush x:Key="AccentHover"   Color="#FF838EF2" />
  <SolidColorBrush x:Key="AccentPressed" Color="#FF5A67D8" />
  <SolidColorBrush x:Key="AccentSoft"    Color="#226E7BE8" />
  <SolidColorBrush x:Key="AccentSubtle"  Color="#146E7BE8" />
  <SolidColorBrush x:Key="AccentInk"     Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="FocusRing"     Color="#FF6E7BE8" />

  <SolidColorBrush x:Key="Spectrum" Color="#FF6E7BE8" />

  <LinearGradientBrush x:Key="SpectrumCTA" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF767FEC" Offset="0.0" />
    <GradientStop Color="#FF5E6ADE" Offset="1.0" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="SpectrumInk" Color="#FFFFFFFF" />

  <SolidColorBrush x:Key="Safe"     Color="#FF5FBE8C" />
  <SolidColorBrush x:Key="Moderate" Color="#FFDFA945" />
  <SolidColorBrush x:Key="Risky"    Color="#FFE25C5C" />

  <SolidColorBrush x:Key="TrackOff" Color="#FF2A2C36" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
