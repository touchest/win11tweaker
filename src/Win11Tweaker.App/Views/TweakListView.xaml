<UserControl x:Class="Win11Tweaker.App.Views.TweakListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" x:Name="ApplyButton"
                    Style="{StaticResource Primary}"
                    Content="{Binding PendingLabel}"
                    IsEnabled="{Binding HasPending}"
                    VerticalAlignment="Top" Margin="0,4,0,0"
                    Click="ApplyPending" />
        </Grid>

        <Border Grid.Row="1" Margin="28,0,28,12" CornerRadius="8" Padding="16,13"
                Background="#1AE25C5C"
                BorderBrush="{StaticResource Risky}" BorderThickness="1"
                Visibility="{Binding IsBlocked, Converter={StaticResource Bool2Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                         Fill="{StaticResource Risky}" />
                <TextBlock Grid.Column="1" Text="{Binding Blocked}" FontSize="14" Margin="12,0,12,0"
                           TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Проверить снова"
                        FontSize="13" VerticalAlignment="Top" Click="Recheck" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,12,8,10" Margin="28,0,28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel Margin="6,0,6,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource GroupLabel}" Margin="3,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Tweaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="5" Padding="12,9" Margin="0,1"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="14" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource Switch}"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding IsAvailable}"
                                                          Foreground="{Binding Accent}"
                                                          Tag="{Binding AccentSoft}" />

                                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" />
                                                        <Ellipse x:Name="PendingDot" Width="6" Height="6"
                                                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                                                 Visibility="Collapsed"
                                                                 Fill="{Binding Accent}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}"
                                                               Margin="0,2,0,0"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource InkFaint}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Note}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           FontSize="12"
                                                           Visibility="{Binding HasNote, Converter={StaticResource Bool2Vis}}"
                                                           Foreground="{StaticResource Moderate}" />

                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Elevated}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                <Setter TargetName="PendingDot" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
