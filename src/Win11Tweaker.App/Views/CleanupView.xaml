<UserControl x:Class="Win11Tweaker.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Обслуживание" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                           Text="{Binding Status}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Просканировать"
                    VerticalAlignment="Bottom" Margin="0,0,10,0" Command="{Binding Scan}" />
            <Button Grid.Column="2" Style="{StaticResource Primary}" Content="Очистить"
                    VerticalAlignment="Bottom" Command="{Binding Clean}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,0,28,24">
        <Border Style="{StaticResource Card}" Padding="10,4,10,14">
            <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupLabel}"
                                           Margin="3,12,0,3" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="6" Padding="13,9" Margin="0,1"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource Switch}"
                                          VerticalAlignment="Top" Margin="0,1,0,0"
                                          IsChecked="{Binding Checked}"
                                          Foreground="{Binding DataContext.Accent,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Tag="{Binding DataContext.AccentSoft,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" />
                                    <TextBlock Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Foreground="{StaticResource InkDim}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="14"
                                           VerticalAlignment="Center" MinWidth="72" TextAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource InkFaint}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Elevated}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
