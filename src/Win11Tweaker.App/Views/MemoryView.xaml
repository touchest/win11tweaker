<UserControl x:Class="Win11Tweaker.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Память" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                       Text="Сколько занято и кем." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Занято" FontSize="13" Foreground="{StaticResource InkFaint}" />
                    <TextBlock Text="{Binding UsedLabel}" FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Свободно" FontSize="13" Foreground="{StaticResource InkFaint}" />
                    <TextBlock Text="{Binding FreeLabel}" FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Всего" FontSize="13" Foreground="{StaticResource InkFaint}" />
                    <TextBlock Text="{Binding TotalLabel}" FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Загрузка" FontSize="13" Foreground="{StaticResource InkFaint}" />
                    <TextBlock Text="{Binding LoadPercent, Mode=OneWay, StringFormat={}{0}%}"
                               FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                    <ProgressBar Style="{StaticResource Meter}" Height="5" Margin="0,8,0,0"
                                 Value="{Binding LoadPercent, Mode=OneWay}"
                                 Foreground="{Binding Accent}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Кто держит больше всех" Style="{StaticResource GroupLabel}"
                   Margin="3,22,0,8" />

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Hogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="6" Padding="14,11" Margin="0,2" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding PidText}" FontSize="14"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource InkFaint}" />
                                    <ProgressBar Grid.Column="2" Style="{StaticResource Meter}" Height="6"
                                                 Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                                 VerticalAlignment="Center" Margin="0,0,24,0"
                                                 Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Working}" FontSize="15"
                                               FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Elevated}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
