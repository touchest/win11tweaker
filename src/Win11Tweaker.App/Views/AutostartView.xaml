<UserControl x:Class="Win11Tweaker.App.Views.AutostartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Автозапуск" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                           Text="Что стартует с системой. Отключение обратимо." />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="14" VerticalAlignment="Bottom"
                       Margin="0,0,0,4" Foreground="{StaticResource InkDim}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="28,0,28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Style="{StaticResource Switch}" VerticalAlignment="Center"
                          IsChecked="{Binding AutoDisable}"
                          Foreground="{Binding Accent}" Tag="{Binding AccentSoft}" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Отключать неизвестные автоматически" FontSize="15" />
                    <TextBlock Text="Всё, кроме доверенных и ваших исключений" FontSize="13"
                               Margin="0,2,0,0" Foreground="{StaticResource InkFaint}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="28,0,28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,14,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Программа" Style="{StaticResource GroupLabel}" />
                    <TextBlock Grid.Column="1" Text="Источник" Style="{StaticResource GroupLabel}" />
                    <TextBlock Grid.Column="2" Text="Статус" Style="{StaticResource GroupLabel}" />
                    <TextBlock Grid.Column="3" Text="Автозапуск" Style="{StaticResource GroupLabel}"
                               HorizontalAlignment="Right" />
                </Grid>
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource Line}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,8,0">
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                Padding="0,11" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Publisher}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource InkFaint}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource InkFaint}" />

                                <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding StatusLabel}" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource InkDim}" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="Trust" Style="{StaticResource Ghost}" Content="В доверенные"
                                            FontSize="12" Margin="0,0,10,0" Click="Trust"
                                            Visibility="Collapsed" />
                                    <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled}"
                                              Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Tag="{Binding DataContext.AccentSoft, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Trusted}" Value="False">
                                <Setter TargetName="Status" Property="Text" Value="неизвестный" />
                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Moderate}" />
                                <Setter TargetName="Trust" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Elevated}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
