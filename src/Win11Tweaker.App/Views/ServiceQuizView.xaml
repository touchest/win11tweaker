<UserControl x:Class="Win11Tweaker.App.Views.ServiceQuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,22,28,14">
            <TextBlock Text="Службы" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                       Text="Опросник вместо списка: отвечайте, чем пользуетесь, остальное Win11 Tweaker отключит с учётом зависимостей." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="28,0,28,24"
                MaxWidth="880">
          <Grid>

            <Grid Visibility="{Binding IsIntro, Converter={StaticResource Bool2Vis}}">
                <StackPanel MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="40,30">
                    <TextBlock Text="Опросник по службам" FontFamily="{StaticResource DisplayFont}"
                               FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding IntroStatus}" FontSize="15" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,14,0,0"
                               Foreground="{StaticResource InkDim}" />
                    <TextBlock Text="Не знаете, что это такое - отвечайте «Нет». Ничего критичного опросник предлагать не будет, а зависимости просчитаются автоматически."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource InkFaint}" />
                    <Button Content="Начать опросник" Style="{StaticResource Primary}"
                            HorizontalAlignment="Center" Margin="0,22,0,0" Padding="26,10"
                            Command="{Binding Start}" />
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsQuestion, Converter={StaticResource Bool2Vis}}"
                  Margin="40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <TextBlock Text="{Binding SectionText}" Style="{StaticResource GroupLabel}" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource InkFaint}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Height="5" Maximum="1"
                                 Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,8,0,0"
                                 Foreground="{Binding Accent}" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding QuestionText}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding HintText}" FontSize="14" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource InkDim}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Button Content="Назад" Style="{StaticResource Ghost}" FontSize="13"
                            HorizontalAlignment="Left" Command="{Binding Back}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Да, пользуюсь" Style="{StaticResource Ghost}"
                                MinWidth="150" Padding="20,10" Command="{Binding Yes}" />
                        <Button Content="Нет, отключить" Style="{StaticResource Primary}"
                                MinWidth="150" Padding="20,10" Margin="14,0,0,0" Command="{Binding No}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsSummary, Converter={StaticResource Bool2Vis}}"
                  Margin="28,22,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SummaryText}" FontSize="17" FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource InkDim}"
                           Text="Ниже службы, которые будут отключены. Всё вступит в силу после перезагрузки; вернуть можно, пройдя опросник заново и ответив «Да»." />

                <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="6" Padding="6"
                        Background="{StaticResource Elevated}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding PlanNames}" Margin="6,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,6"
                                            Background="{StaticResource Hover}">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{StaticResource InkDim}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Status}" FontSize="13" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{StaticResource Safe}"
                               Visibility="{Binding HasStatus, Converter={StaticResource Bool2Vis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Пройти заново" Style="{StaticResource Ghost}"
                                Command="{Binding Restart}" />
                        <Button Content="Применить" Style="{StaticResource Primary}"
                                Margin="12,0,0,0" Command="{Binding Apply}" />
                    </StackPanel>
                </Grid>
            </Grid>
          </Grid>
        </Border>
    </Grid>
</UserControl>
