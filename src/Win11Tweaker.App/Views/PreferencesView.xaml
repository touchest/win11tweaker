<UserControl x:Class="Win11Tweaker.App.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Win11Tweaker.App.Shell">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,22,28,0">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                       Text="Поведение утилиты." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,16,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
            <TextBlock Text="Применение" Style="{StaticResource GroupLabel}" Margin="3,4,0,8" />

            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="6" Padding="13,10" Margin="0,2" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource Switch}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"
                                          IsChecked="{Binding IsEnabled}"
                                          IsEnabled="{Binding Unlocked}"
                                          Foreground="{Binding Accent}"
                                          Tag="{Binding AccentSoft}" />

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="16" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="9,1,0,0"
                                                Background="{StaticResource Pressed}"
                                                Visibility="{Binding Locked, Converter={StaticResource Bool2Vis}}">
                                            <TextBlock Text="всегда включено" FontSize="11"
                                                       Foreground="{StaticResource InkDim}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,4,0,0"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource InkDim}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Elevated}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="О программе" Style="{StaticResource GroupLabel}" Margin="3,4,0,8" />
                <Border Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{x:Static shell:AppInfo.Full}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Margin="0,6,0,0" FontSize="13"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource InkFaint}"
                                   Text="net10.0-windows / WPF" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
