<UserControl x:Class="Win11Tweaker.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="StatCard">
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{Binding Caption}" FontSize="13"
                               Foreground="{StaticResource InkFaint}" />
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Hint}" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource InkDim}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Профиль" Style="{StaticResource PageTitle}" />

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Content="{Binding Stats[0]}"
                            ContentTemplate="{StaticResource StatCard}" HorizontalContentAlignment="Stretch" />
            <ContentControl Grid.Column="2" Content="{Binding Stats[1]}"
                            ContentTemplate="{StaticResource StatCard}" HorizontalContentAlignment="Stretch" />
            <ContentControl Grid.Column="4" Content="{Binding Stats[2]}"
                            ContentTemplate="{StaticResource StatCard}" HorizontalContentAlignment="Stretch" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Система"
                       Style="{StaticResource GroupLabel}" Margin="3,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Диски"
                       Style="{StaticResource GroupLabel}" Margin="3,0,0,8" />

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="22,16">
                <ItemsControl ItemsSource="{Binding Facts}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Margin="0,9,22,9">
                                <TextBlock Text="{Binding Caption}" FontSize="12"
                                           Foreground="{StaticResource InkFaint}" />
                                <TextBlock Text="{Binding Value}" FontSize="14" Margin="0,3,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <ItemsControl ItemsSource="{Binding Volumes}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="15"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Percent}" FontSize="14"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource InkDim}" />
                                </Grid>
                                <ProgressBar x:Name="Bar" Style="{StaticResource Meter}" Height="5"
                                             Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                             Margin="0,8,0,0"
                                             Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Margin="0,6,0,0" FontSize="12"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource InkDim}">
                                    <Run Text="{Binding Used, Mode=OneWay}" />
                                    <Run Text="/" Foreground="{StaticResource InkFaint}" />
                                    <Run Text="{Binding Total, Mode=OneWay}" />
                                    <Run Text="·  своб" Foreground="{StaticResource InkFaint}" />
                                    <Run Text="{Binding Free, Mode=OneWay}" Foreground="{StaticResource InkFaint}" />
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tight}" Value="True">
                                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource Risky}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
