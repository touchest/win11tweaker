<UserControl x:Class="Win11Tweaker.App.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Процессы" Style="{StaticResource PageTitle}" />
            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="{Binding FilterLabel}"
                    VerticalAlignment="Bottom" Command="{Binding ToggleFilter}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,11" Margin="28,0,28,12">
            <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="{StaticResource InkDim}" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="28,0,28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,14,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Процесс" Style="{StaticResource GroupLabel}" />
                    <TextBlock Grid.Column="2" Text="Категория" Style="{StaticResource GroupLabel}" />

                    <TextBlock Grid.Column="3" Text="CPU" Style="{StaticResource GroupLabel}"
                               HorizontalAlignment="Right" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="4" Text="Память" Style="{StaticResource GroupLabel}"
                               HorizontalAlignment="Right" Margin="0,0,12,0" />
                </Grid>

                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource Line}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,8,0">
                    <ItemsControl ItemsSource="{Binding View}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                Padding="0,9" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="Dot" Grid.Column="0" Width="8" Height="8"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{StaticResource InkFaint}" />

                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Publisher}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource InkFaint}" />
                                </StackPanel>

                                <TextBlock x:Name="Cat" Grid.Column="2" Text="{Binding Category}" FontSize="14"
                                           VerticalAlignment="Center" Foreground="{StaticResource InkDim}" />
                                <TextBlock x:Name="Cpu" Grid.Column="3" Text="{Binding Cpu}" FontSize="14"
                                           VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"
                                           Foreground="{StaticResource InkDim}" />
                                <TextBlock Grid.Column="4" Text="{Binding Memory}" FontSize="14"
                                           VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"
                                           Foreground="{StaticResource InkDim}" />

                                <Button x:Name="Kill" Grid.Column="5" Style="{StaticResource Ghost}"
                                        Content="Завершить" FontSize="12" MinWidth="96"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="EndProcess" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Safe}" />
                                <Setter TargetName="Cpu" Property="Foreground" Value="{StaticResource Safe}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Candidate}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Moderate}" />
                                <Setter TargetName="Cat" Property="Foreground" Value="{StaticResource Moderate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Killable}" Value="True">
                                <Setter TargetName="Kill" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Elevated}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
